{
  "name": "pabx-hdl-simulator",
  "version": "0.1.0",
  "description": "Simulador em processo da central PABX HDL: implementa o transporte serial do CTI2 e injeta os pacotes que a central enviaria (ligações, acessos, envio/recebimento de programações), com um painel de controle HTTP.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "pabx",
    "hdl",
    "simulator",
    "serial",
    "cti"
  ],
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "~5.7.2",
    "vitest": "^3.2.4"
  }
}
